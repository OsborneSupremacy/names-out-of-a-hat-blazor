{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "hats": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/hatmetadata"
            },
            "description": "List of hat metadata."
        },
        "organizerName": {
            "type": "string",
            "description": "The name the organizer is known by. Empty when they have no hats yet."
        }
    },
    "required": [
        "organizerName",
        "hats"
    ],
    "definitions": {
        "hatmetadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "hatId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier for the hat."
                },
                "hatName": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 50,
                    "description": "The display name of the hat."
                },
                "status": {
                    "type": "string",
                    "description": "The current status of the gift exchange."
                }
            },
            "required": [
                "hatId",
                "hatName",
                "status"
            ]
        }
    }
}
