{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Participant",
  "type": "object",
  "properties": {
    "pickedRecipient": {
      "type": "string",
      "description": "The name of the person this participant gives a gift to. Empty before the hat is shaken, and 'Hidden' until the hat is closed."
    },
    "person": {
      "$ref": "#/definitions/person",
      "description": "The person who is participating."
    },
    "eligibleRecipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The names this participant is allowed to draw."
    }
  },
  "required": [
    "pickedRecipient",
    "person",
    "eligibleRecipients"
  ],
  "additionalProperties": false,
  "definitions": {
    "person": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "The name of the person."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 254,
          "description": "The email address of the person."
        }
      },
      "required": [
        "name",
        "email"
      ],
      "additionalProperties": false
    }
  }
}
