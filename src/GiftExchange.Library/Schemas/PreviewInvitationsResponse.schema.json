{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "The subject line for the invitation preview"
        },
        "htmlBody": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The HTML body for the invitation preview"
        },
        "senderIpAddress": {
            "type": "string",
            "maxLength": 45,
            "description": "The address the organizer is previewing from, shown back to them before they send."
        }
    },
    "required": [
        "htmlBody",
        "senderIpAddress",
        "subject"
    ],
    "additionalProperties": false
}
